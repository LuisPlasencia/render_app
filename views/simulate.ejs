<!DOCTYPE html>
<html lang="es">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/nav') %>
    <main class="page simulate-page">
      <h1 class="page-title">Simulador</h1>
      <p class="page-lead">Cada red de acceso aloja una población de agentes que generan tráfico hacia los servidores. Ajusta la población, o modifica la red en el editor, y observa cómo cambia la proporción de tráfico y de contenido humano.</p>
      <p class="simulation-disclaimer">Modelo abstracto de nivel 3 con latencia y pérdida por enlace. Demuestra un mecanismo, no la prevalencia real de bots en Internet.</p>

      <div class="simulator-layout">
        <section class="network-panel" aria-label="Topología de red">
          <div class="network-stage">
            <div id="topology-view" class="topology-view"></div>
            <canvas id="packet-layer" class="packet-layer" aria-hidden="true"></canvas>
          </div>
          <ul id="traffic-legend" class="traffic-legend"></ul>
        </section>

        <aside class="side-panel">
          <div class="mode-tabs" role="tablist" aria-label="Modo de trabajo">
            <button type="button" role="tab" id="simulation-tab" class="mode-tab" aria-controls="simulation-panel" aria-selected="true">Simulación</button>
            <button type="button" role="tab" id="editor-tab" class="mode-tab" aria-controls="editor-panel" aria-selected="false">Editor de red</button>
          </div>

          <div id="simulation-panel" role="tabpanel" aria-labelledby="simulation-tab" class="control-panel">
            <p id="simulation-status" class="panel-message" role="alert" hidden></p>
            <div class="control-row">
              <button type="button" id="play-pause-button" class="button button-primary">Iniciar</button>
              <button type="button" id="reset-button" class="button">Reiniciar</button>
            </div>
            <label class="control-field">
              <span>Velocidad</span>
              <select id="speed-select">
                <option value="0.5">x0,5</option>
                <option value="1" selected>x1</option>
                <option value="2">x2</option>
                <option value="5">x5</option>
              </select>
            </label>
            <label class="control-field">
              <span>Semilla</span>
              <input type="number" id="seed-input" value="42" min="1" step="1">
            </label>
            <fieldset class="population-fieldset">
              <legend>Población de agentes</legend>
              <div id="population-controls"></div>
            </fieldset>
          </div>

          <div id="editor-panel" role="tabpanel" aria-labelledby="editor-tab" class="control-panel editor-panel" hidden>
            <section class="editor-section">
              <h2 class="panel-heading">Red</h2>
              <label class="control-field">
                <span>Ejemplo</span>
                <select id="preset-select"></select>
              </label>
              <div class="control-row control-row-wrap">
                <button type="button" id="load-preset-button" class="button">Cargar</button>
                <label class="button file-button">Importar<input type="file" id="import-input" accept="application/json,.json"></label>
                <button type="button" id="export-button" class="button">Exportar</button>
              </div>
            </section>

            <section class="editor-section">
              <h2 class="panel-heading">Herramientas</h2>
              <div id="tool-grid" class="tool-grid">
                <button type="button" class="tool-button" data-tool="select" aria-pressed="true">Seleccionar</button>
                <button type="button" class="tool-button" data-tool="add-link" aria-pressed="false">Enlace</button>
                <button type="button" class="tool-button" data-tool="add-router" aria-pressed="false">Router</button>
                <button type="button" class="tool-button" data-tool="add-access" aria-pressed="false">Acceso</button>
                <button type="button" class="tool-button" data-tool="add-server" aria-pressed="false">Servidor</button>
                <button type="button" id="delete-button" class="tool-button tool-button-danger" disabled>Eliminar</button>
              </div>
              <p id="tool-hint" class="panel-hint" aria-live="polite"></p>
            </section>

            <section class="editor-section">
              <h2 class="panel-heading">Propiedades</h2>
              <div id="properties-panel" class="properties-panel"></div>
            </section>

            <section class="editor-section">
              <h2 class="panel-heading">Validación</h2>
              <ul id="validation-list" class="validation-list" aria-live="polite"></ul>
            </section>

            <button type="button" id="apply-button" class="button button-primary">Aplicar y simular</button>
          </div>
        </aside>
      </div>

      <section class="metrics-panel" aria-label="Métricas">
        <div id="stats-grid" class="stats-grid"></div>
        <div class="chart-card">
          <div class="chart-header">
            <h2 class="chart-title">Reparto del tráfico por tipo de emisor</h2>
            <label class="control-field control-field-inline">
              <span>Unidad</span>
              <select id="unit-select">
                <option value="bytes" selected>Bytes</option>
                <option value="messages">Mensajes</option>
              </select>
            </label>
          </div>
          <div class="chart-canvas-wrapper">
            <canvas id="traffic-share-chart"></canvas>
          </div>
        </div>
      </section>
    </main>
    <%- include('partials/footer') %>
    <script src="/vendor/chart.js/chart.umd.min.js"></script>
    <script type="module" src="/javascripts/pages/simulatePage.js"></script>
  </body>
</html>
